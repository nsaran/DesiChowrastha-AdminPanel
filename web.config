<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- API calls → server/index.js -->
        <rule name="API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="server/index.js" />
        </rule>

        <!-- Static files from React build -->
        <rule name="Static Files" stopProcessing="true">
          <match url=".*\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|mp4|woff|woff2|ttf|json)$" />
          <action type="Rewrite" url="client/build/{R:0}" />
        </rule>

        <!-- All other requests → React index.html (SPA routing) -->
        <rule name="React SPA" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="client/build/index.html" />
        </rule>
      </rules>
    </rewrite>
    <handlers>
      <add name="iisnode" path="server/index.js" verb="*" modules="iisnode" />
    </handlers>
    <iisnode nodeProcessCommandLine=""C:\Program Files\nodejs\node.exe&quot;" />
  </system.webServer>
</configuration>

{
  "jobs": [
    {
      "id": "daily_sales_summary",
      "name": "Daily Sales Summary",
      "enabled": true,
      "schedule": "daily",
      "cronExpression": "0 22 * * *",
      "location": "WESTBOROUGH",
      "templateName": "daily_sale_summary_report",
      "templateLanguage": "en",
      "recipients": [],
      "requestPayload": {
        "endpoint": "/orders/v2/orders",
        "method": "GET",
        "params": {
          "businessDate": "{{TODAY}}"
        }
      },
      "responsePayload": {
        "templateParams": ["{{totalOrders}}", "{{totalRevenue}}", "{{date}}"]
      }
    },
    {
      "id": "weekly_inventory_report",
      "name": "Weekly Inventory Report",
      "enabled": false,
      "schedule": "weekly",
      "cronExpression": "0 9 * * 1",
      "location": "WESTBOROUGH",
      "templateName": "weekly_inventory_report",
      "templateLanguage": "en",
      "recipients": [],
      "requestPayload": {
        "endpoint": "/stock/v1/inventory",
        "method": "GET",
        "params": {}
      },
      "responsePayload": {
        "templateParams": ["{{lowStockItems}}", "{{outOfStockCount}}"]
      }
    },
    {
      "id": "monthly_performance",
      "name": "Monthly Performance Report",
      "enabled": false,
      "schedule": "monthly",
      "cronExpression": "0 9 1 * *",
      "location": "WESTBOROUGH",
      "templateName": "monthly_performance",
      "templateLanguage": "en",
      "recipients": [],
      "requestPayload": {
        "endpoint": "/reporting/v1/summary",
        "method": "GET",
        "params": {
          "month": "{{LAST_MONTH}}"
        }
      },
      "responsePayload": {
        "templateParams": ["{{month}}", "{{totalRevenue}}", "{{topItems}}"]
      }
    },
    {
      "id": "yearly_review",
      "name": "Yearly Business Review",
      "enabled": false,
      "schedule": "yearly",
      "cronExpression": "0 9 1 1 *",
      "location": "WESTBOROUGH",
      "templateName": "yearly_review",
      "templateLanguage": "en",
      "recipients": [],
      "requestPayload": {
        "endpoint": "/reporting/v1/annual",
        "method": "GET",
        "params": {
          "year": "{{LAST_YEAR}}"
        }
      },
      "responsePayload": {
        "templateParams": ["{{year}}", "{{totalRevenue}}", "{{growth}}"]
      }
    },
    {
      "id": "nashua_daily_sales_summary",
      "name": "Nashua Daily Sales Summary",
      "enabled": true,
      "schedule": "daily",
      "cronExpression": "5 22 * * *",
      "location": "NASHUA",
      "templateName": "daily_sale_summary_report",
      "templateLanguage": "en",
      "recipients": [],
      "requestPayload": {
        "endpoint": "/orders/v2/orders",
        "method": "GET",
        "params": {
          "businessDate": "{{TODAY}}"
        }
      },
      "responsePayload": {
        "templateParams": ["{{totalOrders}}", "{{totalRevenue}}", "{{date}}"]
      }
    },
    {
      "id": "nashua_party_orders_monthly_csv",
      "name": "Nashua Party Orders Monthly CSV",
      "enabled": true,
      "schedule": "monthly",
      "cronExpression": "0 9 1 * *",
      "location": "NASHUA",
      "templateName": "party_order_invoice",
      "templateLanguage": "en",
      "recipients": []
    },
    {
      "id": "westborough_party_orders_monthly_csv",
      "name": "Westborough Party Orders Monthly CSV",
      "enabled": true,
      "schedule": "monthly",
      "cronExpression": "0 9 1 * *",
      "location": "WESTBOROUGH",
      "templateName": "party_order_invoice",
      "templateLanguage": "en",
      "recipients": []
    },
    {
      "id": "nashua_bank_statement_reminder",
      "name": "Nashua Bank Statement Upload Reminder",
      "enabled": true,
      "schedule": "daily-until-uploaded",
      "cronExpression": "0 10 1-10 * *",
      "location": "NASHUA",
      "templateName": "bank_statement_reminder",
      "templateLanguage": "en",
      "recipients": []
    },
    {
      "id": "westborough_bank_statement_reminder",
      "name": "Westborough Bank Statement Upload Reminder",
      "enabled": true,
      "schedule": "daily-until-uploaded",
      "cronExpression": "0 10 1-10 * *",
      "location": "WESTBOROUGH",
      "templateName": "bank_statement_reminder",
      "templateLanguage": "en",
      "recipients": []
    }
  ]
}
